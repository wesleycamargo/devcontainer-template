{
  "name": "AI Hermes Devbox",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  // Leave the Compose project running when the VS Code window closes. This
  // container is an SSH gateway: `stopCompose` would tear down the SSH daemon underneath
  // a connected Hermes Desktop just because an editor window was closed. Stop
  // it deliberately instead, with `docker compose down`.
  "shutdownAction": "none",
  "remoteUser": "hermes",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": "true",
      "username": "hermes",
      "upgradePackages": "false",
      "nonFreePackages": "true"
    },
    "ghcr.io/rchaganti/vsc-devcontainer-features/azurebicep:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Editor/development concerns only. SSH and the Hermes services are owned by
  // the image's entrypoint, so they behave identically under `docker run` and
  // `docker compose` -- there is deliberately no Dev Container startup hook here.
  "postCreateCommand": "cp /tmp/host-gitconfig ~/.gitconfig 2>/dev/null || true; cp /tmp/host-git-credentials ~/.git-credentials 2>/dev/null || true; chmod 600 ~/.git-credentials 2>/dev/null || true",
  // Hermes dashboard. Binds loopback inside the container, so VS Code
  // forwards it rather than Docker publishing it.
  "forwardPorts": [9119],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "pwsh",
        "terminal.integrated.profiles.linux": {
          "pwsh": {
            "path": "pwsh"
          }
        },
        "terminal.integrated.fontFamily": "MesloLGM Nerd Font"
      },
      "extensions": [
        "ms-vscode.powershell",
        "anthropic.claude-code"
      ]
    }
  }
}

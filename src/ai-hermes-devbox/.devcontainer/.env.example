# Copy to `.env` next to docker-compose.yml. Compose loads it automatically.
#
# Per-project host port for the SSH gateway. The port INSIDE the container is
# always 2222; only the host side changes, which is what lets several projects
# run at the same time. Pick a value once per project and keep it: Hermes
# Desktop stores the port in its connection, so a value that moves between
# restarts breaks the saved connection. Docker-assigned random ports are
# unsuitable for the same reason.
HERMES_SSH_PORT=2222

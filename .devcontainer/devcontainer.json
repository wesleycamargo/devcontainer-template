{
  "name": "AI Hermes Devbox",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  // Compose owns container lifecycle now (see docker-compose.yml); stop the
  // service on close instead of leaving it running detached.
  "shutdownAction": "stopCompose",
  "remoteUser": "hermes",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": "true",
      "username": "hermes",
      "upgradePackages": "false",
      "nonFreePackages": "true"
    },
    "ghcr.io/rchaganti/vsc-devcontainer-features/azurebicep:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Hermes services are image-owned. The post-create hook only configures
  // the current workspace as the Hermes project skill source.
  "postCreateCommand": "cp /tmp/host-gitconfig ~/.gitconfig 2>/dev/null || true; cp /tmp/host-git-credentials ~/.git-credentials 2>/dev/null || true; chmod 600 ~/.git-credentials 2>/dev/null || true; bash .devcontainer/scripts/configure-project-skills.sh "$PWD"",
  "forwardPorts": [9119],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "pwsh",
        "terminal.integrated.profiles.linux": {
          "pwsh": {
            "path": "pwsh"
          }
        },
        "terminal.integrated.fontFamily": "MesloLGM Nerd Font"
      },
      "extensions": [
        "ms-vscode.powershell",
        "anthropic.claude-code"
      ]
    }
  }
}

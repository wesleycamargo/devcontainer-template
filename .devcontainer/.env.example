# Copy to `.env` next to docker-compose.yml. Compose loads it automatically.
# DEVBOX_HOST_HOME defaults to the WSL/Linux/macOS home running Docker.
# First run on that host: codex -c 'cli_auth_credentials_store="file"' login
# Its ~/.codex/auth.json must exist before Compose starts.
# DEVBOX_HOST_HOME=/home/your-user
#
# Default: gateway/Webapp enabled, dashboard disabled.
# Set HERMES_AUTOSTART_SERVICES=0 for the development shell only; recreate to apply.
HERMES_AUTOSTART_SERVICES=1
HERMES_AUTOSTART_DASHBOARD=0
# To also start the dashboard: HERMES_AUTOSTART_DASHBOARD=1

# Optional non-secret Hermes defaults. Saved config wins; recreate to apply.
# Uncomment only what you need. Blank values do nothing.
# HERMES_MODEL_PROVIDER=openai-codex
# HERMES_DEFAULT_MODEL=your-provider-model-id
# Custom endpoint requires HERMES_MODEL_PROVIDER=custom.
# HERMES_MODEL_BASE_URL=http://model-server:8000/v1
# Absolute target/container path, not a host path or VS Code substitution.
# HERMES_TERMINAL_CWD=/workspaces/your-project
# HERMES_TERMINAL_BACKEND=local
# HERMES_TERMINAL_TIMEOUT=240
# HERMES_WEBAPP_ENABLED=true
# HERMES_WEBAPP_HOST=127.0.0.1
# HERMES_WEBAPP_PORT=9120
# No API keys, tokens or passwords here; use Hermes' private secret store.
